{
  "name": "Growth Analytics",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "background": "#fcfcfb",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "minimum": "#cde2fb",
  "center": "#f0efec",
  "maximum": "#0d366b",
  "textClasses": {
    "title": { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52514e" },
    "callout": { "fontSize": 30, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#fcfcfb" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#e1e0d9" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 14, "right": 14 }],
        "title": [{
          "show": true,
          "fontSize": 13,
          "fontFamily": "Segoe UI Semibold",
          "fontColor": { "solid": { "color": "#0b0b0b" } },
          "alignment": "left"
        }],
        "legend": [{
          "position": "Top",
          "showTitle": false,
          "fontSize": 10,
          "labelColor": { "solid": { "color": "#52514e" } }
        }],
        "categoryAxis": [{
          "gridlineShow": false,
          "showAxisTitle": false,
          "fontSize": 10,
          "labelColor": { "solid": { "color": "#52514e" } }
        }],
        "valueAxis": [{
          "gridlineShow": true,
          "gridlineColor": { "solid": { "color": "#e1e0d9" } },
          "showAxisTitle": false,
          "fontSize": 10,
          "labelColor": { "solid": { "color": "#898781" } }
        }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#f9f9f7" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#f0efec" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{
          "fontSize": 30,
          "fontFamily": "Segoe UI Semibold",
          "color": { "solid": { "color": "#0b0b0b" } }
        }],
        "categoryLabels": [{
          "show": true,
          "fontSize": 11,
          "color": { "solid": { "color": "#52514e" } }
        }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#e1e0d9" } },
          "gridHorizontalWeight": 1,
          "rowPadding": 6,
          "textSize": 11
        }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#0b0b0b" } },
          "backColor": { "solid": { "color": "#f0efec" } },
          "fontSize": 11,
          "bold": true
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#0b0b0b" } },
          "backColorPrimary": { "solid": { "color": "#fcfcfb" } },
          "backColorSecondary": { "solid": { "color": "#fcfcfb" } },
          "fontSize": 11
        }],
        "total": [{ "totals": false }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    }
  }
}
